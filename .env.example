# این فایل را به .env کپی کنید و مقدارها را بگذارید (همه اختیاری‌اند).

# فال‌بکِ Claude برای دستورهای آزاد + حافظه + مأموریت + خلاصه‌ی وب
ANTHROPIC_API_KEY=

# Spotify (developer.spotify.com → یک app بسازید)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Notion (notion.so/my-integrations → Internal Integration)
NOTION_TOKEN=

# تلگرام (@BotFather → /newbot ؛ owner_id را از @userinfobot بگیرید)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
